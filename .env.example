# ── Core ─────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://zitouna:zitouna@localhost:5434/zitounadefi?schema=public"
PORT=4000
APP_BASE_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# stub = simulated ledger (no keys needed). hedera = real testnet.
LEDGER_MODE=stub
HEDERA_NETWORK=testnet

# ── Hedera operator (fill in, never commit) ──────────────────────────
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=
HEDERA_OPERATOR_PUBLIC_KEY=

# ── Generated by `bun run setup:hedera` ──────────────────────────────
TREASURY_ACCOUNT_ID=
TREASURY_KEY=
PRODUCER_ACCOUNT_ID=
PRODUCER_KEY=
BUYER_A_ACCOUNT_ID=
BUYER_A_KEY=
BUYER_B_ACCOUNT_ID=
BUYER_B_KEY=
AUDITOR_PUBLIC_KEY=
AUDITOR_PRIVATE_KEY_PATH=keys/auditor-private.jwk.json
TUSDT_TOKEN_ID=
DGZ_TOKEN_ID=
TZT_TOKEN_ID=
LOT_NFT_TOKEN_ID=
AGENT_TOPIC_ID=

# ── Policy ───────────────────────────────────────────────────────────
ATTESTATION_STALE_SECONDS=2592000
DEMO_STALE_SECONDS=60
PAUSE_AGENT=false
TND_PER_USD_CENTS=310
REDEMPTION_DEADLINE_SECONDS=604800
LOW_STOCK_BPS=1000

# ── Public chain reads ───────────────────────────────────────────────
MIRROR_BASE=https://testnet.mirrornode.hedera.com/api/v1
HASHSCAN_BASE=https://hashscan.io/testnet

# ── Frontend (Vite reads these from the repo root) ───────────────────
VITE_API_BASE=http://localhost:4000
VITE_MIRROR_BASE=https://testnet.mirrornode.hedera.com/api/v1
