{
  "name": "@zitouna/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.js",
    "start": "bun src/index.js",
    "prisma:generate": "dotenv -e ../../.env -- prisma generate",
    "prisma:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:push": "dotenv -e ../../.env -- prisma db push",
    "db:reset": "dotenv -e ../../.env -- prisma migrate reset --force",
    "seed": "dotenv -e ../../.env -- bun src/scripts/seed.js",
    "setup:hedera": "dotenv -e ../../.env -- bun src/scripts/setup-hedera.js",
    "smoke": "dotenv -e ../../.env -- bun src/scripts/smoke.js",
    "test": "bun test test/api.test.js"
  },
  "dependencies": {
    "@hiero-ledger/sdk": "^2.90.1",
    "@prisma/client": "^6.16.0",
    "@zitouna/rules": "workspace:*",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "pino": "^9.7.0",
    "pino-http": "^10.5.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "dotenv-cli": "^10.0.0",
    "prisma": "^6.16.0",
    "supertest": "^7.1.4"
  }
}
